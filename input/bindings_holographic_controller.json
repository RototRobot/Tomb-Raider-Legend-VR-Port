{
  "controller_type": "holographic_controller",
  "description": "Tomb Raider: Legend VR -- Windows Mixed Reality controllers",
  "name": "Tomb Raider: Legend VR",
  "bindings": {
    "/actions/trlvr": {
      "sources": [
        {
          "path": "/user/hand/left/input/joystick",
          "mode": "joystick",
          "inputs": {
            "position": {
              "output": "/actions/trlvr/in/stick_left"
            },
            "click": {
              "output": "/actions/trlvr/in/stick_click_left"
            }
          }
        },
        {
          "path": "/user/hand/left/input/trigger",
          "mode": "trigger",
          "inputs": {
            "pull": {
              "output": "/actions/trlvr/in/trigger_left"
            }
          }
        },
        {
          "path": "/user/hand/left/input/grip",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/trlvr/in/squeeze_left"
            }
          }
        },
        {
          "path": "/user/hand/left/input/trackpad",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/trlvr/in/trackpad_left"
            }
          }
        },
        {
          "path": "/user/hand/left/input/application_menu",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/trlvr/in/menu_left"
            }
          }
        },
        {
          "path": "/user/hand/right/input/joystick",
          "mode": "joystick",
          "inputs": {
            "position": {
              "output": "/actions/trlvr/in/stick_right"
            },
            "click": {
              "output": "/actions/trlvr/in/stick_click_right"
            }
          }
        },
        {
          "path": "/user/hand/right/input/trigger",
          "mode": "trigger",
          "inputs": {
            "pull": {
              "output": "/actions/trlvr/in/trigger_right"
            }
          }
        },
        {
          "path": "/user/hand/right/input/grip",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/trlvr/in/squeeze_right"
            }
          }
        },
        {
          "path": "/user/hand/right/input/trackpad",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/trlvr/in/trackpad_right"
            }
          }
        },
        {
          "path": "/user/hand/right/input/application_menu",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/trlvr/in/menu_right"
            }
          }
        }
      ],
      "poses": [
        {
          "output": "/actions/trlvr/in/hand_left",
          "path": "/user/hand/left/pose/grip"
        },
        {
          "output": "/actions/trlvr/in/hand_xr_left",
          "path": "/user/hand/left/pose/openxr_grip"
        },
        {
          "output": "/actions/trlvr/in/hand_right",
          "path": "/user/hand/right/pose/grip"
        },
        {
          "output": "/actions/trlvr/in/hand_xr_right",
          "path": "/user/hand/right/pose/openxr_grip"
        }
      ],
      "haptics": [
        {
          "output": "/actions/trlvr/out/haptic_left",
          "path": "/user/hand/left/output/haptic"
        },
        {
          "output": "/actions/trlvr/out/haptic_right",
          "path": "/user/hand/right/output/haptic"
        }
      ]
    }
  }
}
